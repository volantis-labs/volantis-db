@dataclass(frozen=True)
class Tensor:
    name: str
    shape: tuple[int, ...]
    data: bytes
    digest: int
    dtype: int = 0


@dataclass(frozen=True)
class Tower:
    role: int
    model_id: str
    root: Path
    prefix: str
    config: dict
    pooling: int
    architecture: int
    dense_out: int
    tensors: tuple[Tensor, ...]
    weights_digest: bytes


def u16(value: int) -> bytes:
    return struct.pack("<H", value)


def u32(value: int) -> bytes:
    return struct.pack("<I", value)


def u64(value: int) -> bytes:
    return struct.pack("<Q", value)


def field(value: bytes) -> bytes:
    return u32(len(value)) + value


def string(value: str) -> bytes:
    return field(value.encode("utf-8"))


def json_file(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as source:
        return json.load(source)


def checkpoint_tensor(path: Path, name: str) -> torch.Tensor:
    with safe_open(path, framework="pt", device="cpu") as source:
        return source.get_tensor(name)


def load_tensors(root: Path, role_name: str, dense_out: int, precision: str = "fp32") -> tuple[Tensor, ...]:
    model = root / "model.safetensors"
    if not model.is_file():
        raise ValueError(f"checkpoint has no model.safetensors: {root}")
    values: list[tuple[str, torch.Tensor]] = []
    with safe_open(model, framework="pt", device="cpu") as source:
        for name in source.keys():
            values.append((name, source.get_tensor(name)))
    if dense_out:
        dense = root / "2_Dense" / "model.safetensors"
        if not dense.is_file():
            raise ValueError(f"Dense head declared but absent: {dense}")
        values.extend(
            (f"dense.{name.removeprefix('linear.')}", checkpoint_tensor(dense, name))
            for name in ("linear.weight", "linear.bias")
        )
    tensors = []
    for name, value in values:
        dtype, numpy_dtype, dtype_id = {
            "fp32": (torch.float32, "<f4", 0), "fp16": (torch.float16, "<f2", 1)
        }[precision]
        value = value.detach().to(dtype=dtype).contiguous()
        if not torch.isfinite(value).all():
            raise ValueError(f"non-finite {precision} tensor: {role_name}/{name}")
        data = value.numpy().astype(numpy_dtype, copy=False).tobytes(order="C")
        tensors.append(
            Tensor(
                name=f"{role_name}/{name}",
                shape=tuple(value.shape),
                data=data,
                digest=xxhash.xxh3_64_intdigest(data),
                dtype=dtype_id,
            )
        )
    return tuple(tensors)


def declared_query_prefix(root: Path) -> str:
    config_path = root / "config_sentence_transformers.json"
    if not config_path.is_file():
        return ""
    prompts = json_file(config_path).get("prompts", {})
    return str(prompts.get("query", ""))


def load_tower(
    root: Path,
    model_id: str,
    role: int,
    role_name: str,
    confirmed_prefix: str,
    precision: str = "fp32",
    check_prompt: bool = True,
) -> Tower:
    config = json_file(root / "config.json")
    declared_prefix = declared_query_prefix(root) if confirmed_prefix else ""
    if check_prompt and declared_prefix != confirmed_prefix:
        raise ValueError(
            f"confirmed prefix {confirmed_prefix!r} differs from checkpoint "
            f"declaration {declared_prefix!r}"
        )
    model_type = config.get("model_type")
    if model_type == "bert":
        architecture = 1
    elif model_type == "gte":
        architecture = 2
    elif model_type == "arctic_query":
        architecture = 3
    else:
        raise ValueError(f"unsupported architecture {model_type!r}")
    pooling_config = root / "1_Pooling" / "config.json"
    pooling_data = json_file(pooling_config) if pooling_config.is_file() else {}
    if pooling_data.get("pooling_mode_mean_tokens"):
        pooling = 1
    elif pooling_data.get("pooling_mode_lasttoken"):
        pooling = 3
    else:
        pooling = 2
    dense_config = root / "2_Dense" / "config.json"
    dense_out = int(json_file(dense_config)["out_features"]) if dense_config.is_file() else 0
    tensors = load_tensors(root, role_name, dense_out, precision)
    weights = b"".join(tensor.data for tensor in tensors)
    return Tower(
        role=role,
        model_id=model_id,
        root=root,
        prefix=confirmed_prefix,
        config=config,
        pooling=pooling,
        architecture=architecture,
        dense_out=dense_out,
        tensors=tensors,
        weights_digest=xxhash.xxh3_128_intdigest(weights).to_bytes(16, "little"),
    )


def encode_tower(tower: Tower, max_tokens: int | None = None) -> bytes:
    config = tower.config
    max_positions = int(config["max_position_embeddings"])
    if max_tokens is None:
        if tower.architecture == 3:
            max_tokens = int(json_file(tower.root / "sentence_bert_config.json")["max_seq_length"])
        else:
            truncation = json_file(tower.root / "tokenizer.json").get("truncation") or {}
            max_tokens = int(truncation.get("max_length", max_positions))
    if not 2 <= max_tokens <= max_positions:
        raise ValueError(f"{tower.model_id} max_tokens must be between 2 and {max_positions}, got {max_tokens}")
    hidden = int(config["hidden_size"])
    dims = int(config["output_dimension"]) if tower.architecture == 3 else tower.dense_out or hidden
    if tower.architecture == 3:
        if (int(config["embedding_rank"]) <= 0 or dims <= 0
                or tower.pooling != 2 or tower.dense_out):
            raise ValueError("invalid ArcticQuery dimensions, pooling or projection")
    output = bytearray([tower.role])
    output += string(tower.model_id)
    output += string(tower.root.name)
    output += field(tower.weights_digest)
    output += u32(dims)
    output += u16(1)
    output += string(tower.prefix)
    output += u32(max_tokens)
    output += u16(2)
    output += u16(2)
    output += b"\x00"
    output += bytes([tower.pooling])
    output += u16(tower.architecture)
    output += u16(int(config["num_hidden_layers"]))
    output += u32(hidden)
    output += u16(int(config["num_attention_heads"]))
    output += u32(int(config["intermediate_size"]))
    output += u32(1 if tower.architecture == 3 else int(config.get("type_vocab_size", 0)))
    output += u32(int(config["max_position_embeddings"]))
    output += struct.pack("<f", float(config["layer_norm_eps"]))
    output += struct.pack("<f", float(config.get("rope_theta", 10_000.0)))
    output += u32(tower.dense_out)
    if tower.architecture == 3:
        output += u32(int(config["embedding_rank"]))
        output += u32(dims)
    return bytes(output)


def wordpiece_flags(tokenizer: dict) -> int:
    """Validate the complete single-sequence WordPiece contract representable in v1.

    Bundle limits/padding are selected by the caller, not tokenizer.json's saved
    encode options. Decoding and paired-sequence templates are never executed.
    """
    normalizer = tokenizer.get("normalizer", {})
    lower = normalizer.get("lowercase")
    strip = normalizer.get("strip_accents")
    if (normalizer.get("type") != "BertNormalizer"
            or normalizer.get("clean_text") is not True
            or normalizer.get("handle_chinese_chars") is not True
            or type(lower) is not bool
            or (strip is not None and type(strip) is not bool)
            or (lower and strip is False)):
        raise ValueError("bundle requires BERT cleaning/CJK and uncased default accent stripping")
    if tokenizer.get("pre_tokenizer") != {"type": "BertPreTokenizer"}:
        raise ValueError("bundle requires BertPreTokenizer")
    model = tokenizer["model"]
    if (model.get("type") != "WordPiece" or model.get("unk_token") != "[UNK]"
            or model.get("continuing_subword_prefix") != "##"
            or model.get("max_input_chars_per_word") != 100):
        raise ValueError("bundle requires standard WordPiece with a 100-character limit")
    vocab = model["vocab"]
    if sorted(vocab.values()) != list(range(len(vocab))):
        raise ValueError("WordPiece vocabulary IDs must be contiguous from zero")
    specials = ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]
    if any(token not in vocab for token in specials):
        raise ValueError("bundle requires the five standard BERT special tokens")
    expected_added = [{"id": vocab[token], "content": token, "single_word": False,
                       "lstrip": False, "rstrip": False, "normalized": False, "special": True}
                      for token in specials]
    added = tokenizer.get("added_tokens", [])
    if sorted(added, key=lambda token: token["id"]) != sorted(expected_added, key=lambda token: token["id"]):
        raise ValueError("bundle cannot represent different or additional special-token matching")
    post = tokenizer.get("post_processor", {})
    expected_single = [{"SpecialToken": {"id": "[CLS]", "type_id": 0}},
                       {"Sequence": {"id": "A", "type_id": 0}},
                       {"SpecialToken": {"id": "[SEP]", "type_id": 0}}]
    expected_specials = {token: {"id": token, "ids": [vocab[token]], "tokens": [token]}
                         for token in ["[CLS]", "[SEP]"]}
    if (post.get("type") != "TemplateProcessing" or post.get("single") != expected_single
            or post.get("special_tokens") != expected_specials):
        raise ValueError("bundle requires a single CLS/sequence/SEP template with type ID zero")
    return int(lower) | (int(lower if strip is None else strip) << 1)


# Tokenizer flag bit 2: source-exact XLM-R Unigram input. The evaluator applies
# special-token matching, the charsmap, ASCII-space collapse, then Metaspace
# (replace " ", prepend "▁" to every segment, split before each "▁").
METASPACE_UNIGRAM = 4
XLMR_SPECIALS = ["<s>", "<pad>", "</s>", "<unk>", "<mask>"]
METASPACE_FORMS = [
    {"type": "Metaspace", "replacement": "\u2581", "prepend_scheme": "always", "split": True},
    # tokenizers 0.19 reads this legacy form as prepend_scheme=always, split=true.
    {"type": "Metaspace", "replacement": "\u2581", "add_prefix_space": True},
]


def metaspace_unigram(tokenizer: dict, config: dict) -> tuple[int, list, bytes]:
    """Validate the complete single-sequence BERT + XLM-R Unigram contract.

    Saved encode options are not used: the bundle records each tower's limit.
    Decoding and paired-sequence templates are never executed.
    """
    normalizer = tokenizer.get("normalizer") or {}
    steps = normalizer.get("normalizers") or [{}, {}]
    if (normalizer.get("type") != "Sequence" or len(steps) != 2
            or set(steps[0]) != {"type", "precompiled_charsmap"}
            or steps[0].get("type") != "Precompiled"
            or steps[1] != {"type": "Replace", "pattern": {"Regex": " {2,}"}, "content": " "}):
        raise ValueError("BERT Unigram requires the normalizer "
                         "Sequence[Precompiled, Replace(' {2,}', ' ')]")
    charsmap = base64.b64decode(steps[0]["precompiled_charsmap"], validate=True)
    if len(charsmap) < 8:
        raise ValueError("Precompiled normalizer must carry a charsmap")
    if tokenizer.get("pre_tokenizer") not in METASPACE_FORMS:
        raise ValueError("BERT Unigram requires Metaspace('\u2581', prepend always, split)")
    model = tokenizer["model"]
    if (set(model) - {"type", "unk_id", "vocab", "byte_fallback"}
            or model.get("byte_fallback", False) is not False):
        raise ValueError("bundle requires a plain Unigram model without byte fallback")
    entries = [(str(token), float(score)) for token, score in model["vocab"]]
    vocab = {token: index for index, (token, _) in enumerate(entries)}
    if len(vocab) != len(entries) or any(token not in vocab for token in XLMR_SPECIALS):
        raise ValueError("Unigram vocabulary must be unique and hold the XLM-R special tokens")
    expected_added = [{"id": vocab[token], "content": token, "single_word": False,
                       "lstrip": False, "rstrip": False, "normalized": False, "special": True}
                      for token in XLMR_SPECIALS]
    added = tokenizer.get("added_tokens", [])
    if sorted(added, key=lambda token: token["id"]) != expected_added:
        raise ValueError("bundle cannot represent this added token matching")
    post = tokenizer.get("post_processor") or {}
    single = [{"SpecialToken": {"id": "<s>", "type_id": 0}},
              {"Sequence": {"id": "A", "type_id": 0}},
              {"SpecialToken": {"id": "</s>", "type_id": 0}}]
    specials = {token: {"id": token, "ids": [vocab[token]], "tokens": [token]}
                for token in ["<s>", "</s>"]}
    if (post.get("type") != "TemplateProcessing" or post.get("single") != single
            or post.get("special_tokens") != specials):
        raise ValueError("bundle requires a single <s>/sequence/</s> template with type ID zero")
    for option in ["truncation", "padding"]:
        if (tokenizer.get(option) or {}).get("direction", "Right") != "Right":
            raise ValueError("bundle requires right padding and right truncation")
    if config.get("do_lower_case") or config.get("strip_accents"):
        raise ValueError("tokenizer_config.json contradicts the Unigram normalizer")
    if any(config.get(key, "right") != "right" for key in ["padding_side", "truncation_side"]):
        raise ValueError("bundle requires right padding and right truncation")
    # A tokenizer_config.json mask_token dict (e5: lstrip=true) does not change
    # the loaded fast tokenizer; tokenizer.json added_tokens are authoritative.
    # The WF-986 parity check compares this loader with the raw source tokenizer.
    by_id = {item["id"]: item for item in added}
    for configured_id, token in config.get("added_tokens_decoder", {}).items():
        if {"id": int(configured_id), **token} != by_id.get(int(configured_id)):
            raise ValueError("tokenizer_config.json contradicts the added token matching")
    return METASPACE_UNIGRAM, entries, charsmap


def encode_tokenizer(root: Path, architecture: int) -> bytes:
    tokenizer = json_file(root / "tokenizer.json")
    config = json_file(root / "tokenizer_config.json")
    charsmap = b""
    model = tokenizer["model"]
    if architecture == 1 and model.get("type") == "Unigram":
        kind = 2
        flags, entries, charsmap = metaspace_unigram(tokenizer, config)
    elif architecture == 1:
        kind = 1
        flags = wordpiece_flags(tokenizer)
        if ("do_lower_case" in config and config["do_lower_case"] is not bool(flags & 1)
                or "tokenize_chinese_chars" in config and config["tokenize_chinese_chars"] is not True):
            raise ValueError("tokenizer_config.json contradicts the BERT normalizer")
        if "strip_accents" in config:
            strip = config["strip_accents"]
            effective = bool(flags & 1) if strip is None else strip
            if effective is not bool(flags & 2):
                raise ValueError("tokenizer_config.json contradicts BERT accent stripping")
        if any(config.get(key, "right") != "right" for key in ["padding_side", "truncation_side"]):
            raise ValueError("bundle requires right padding and right truncation")
        mask = config.get("mask_token", "[MASK]")
        if isinstance(mask, dict):
            mask = mask.get("content")
        if mask != "[MASK]" or config.get("extra_special_tokens"):
            raise ValueError("bundle requires only the five standard BERT special tokens")
        added = {item["id"]: item for item in tokenizer["added_tokens"]}
        for configured_id, token in config.get("added_tokens_decoder", {}).items():
            if {"id": int(configured_id), **token} != added.get(int(configured_id)):
                raise ValueError("tokenizer_config.json contradicts BERT special-token matching")
        vocabulary = sorted(model["vocab"].items(), key=lambda item: item[1])
        entries = [(token, 0.0) for token, _ in vocabulary]
    elif model.get("type") == "Unigram":
        kind = 2
        normalizer = tokenizer.get("normalizer")
        if normalizer is not None:
            if normalizer.get("type") != "Precompiled":
                raise ValueError(f"unsupported Unigram normalizer {normalizer.get('type')!r}")
            charsmap = base64.b64decode(normalizer["precompiled_charsmap"], validate=True)
            if not charsmap:
                raise ValueError("Precompiled normalizer must carry a charsmap")
        flags = int(bool(config.get("do_lower_case", False)))
        entries = [(token, float(score)) for token, score in model["vocab"]]
    else:
        raise ValueError(f"unsupported tokenizer model {model.get('type')!r}")
    added = {item["content"]: int(item["id"]) for item in tokenizer.get("added_tokens", [])}
    vocab_ids = {token: index for index, (token, _) in enumerate(entries)}

    def token_id(name: str, fallback: str) -> int:
        value = config.get(name, fallback)
        if isinstance(value, dict):
            value = value.get("content", fallback)
        if value in added:
            return added[value]
        if value in vocab_ids:
            return vocab_ids[value]
        raise ValueError(f"tokenizer has no {name}: {value!r}")

    if flags & METASPACE_UNIGRAM:
        selected = [token_id(name, fallback) for name, fallback in
                    [("pad_token", "<pad>"), ("unk_token", "<unk>"),
                     ("cls_token", "<s>"), ("sep_token", "</s>")]]
        if selected != [vocab_ids[token] for token in ["<pad>", "<unk>", "<s>", "</s>"]]:
            raise ValueError("tokenizer_config.json contradicts the XLM-R special tokens")
        if model.get("unk_id") != vocab_ids["<unk>"]:
            raise ValueError("Unigram unk_id must name <unk>")
    output = bytearray([kind, flags, 0, 0])
    for name, fallback in [("pad_token", "[PAD]" if kind == 1 else "<pad>"),
                           ("unk_token", "[UNK]" if kind == 1 else "<unk>"),
                           ("cls_token", "[CLS]" if kind == 1 else "<s>"),
                           ("sep_token", "[SEP]" if kind == 1 else "</s>")]:
        selected = token_id(name, fallback)
        if kind == 1 and selected != vocab_ids[fallback]:
            raise ValueError(f"bundle requires the standard BERT {name}")
        output += u32(selected)
    output += u32(len(entries))
    for token, score in entries:
        output += string(token)
        output += struct.pack("<d", score)
    output += field(charsmap)
    return bytes(output)


def tensor_descriptor(tensor: Tensor, offset: int) -> bytes:
    output = bytearray(string(tensor.name))
    output += bytes([tensor.dtype, len(tensor.shape), 0, 0])
    for dimension in tensor.shape:
        output += u32(dimension)
    output += u64(offset)
    output += u64(len(tensor.data))
    output += u64(tensor.digest)
    return bytes(output)


