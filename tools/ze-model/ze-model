def file_sha256(path: Path) -> str:
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def pair_source(root: Path, record: dict, dimension: int, prompt: str) -> dict:
    """Check one PAIR.json tower folder before its weights are read."""
    for key, name in [("weights_sha256", "model.safetensors"), ("tokenizer_sha256", "tokenizer.json")]:
        if key in record and file_sha256(root / name) != record[key]:
            raise ValueError(f"{root.name}/{name} sha256 differs from PAIR.json {key}")
    config = json_file(root / "config.json")
    if config.get("model_type") != "bert":
        raise ValueError(f"{root.name}: pair towers must be bert, got {config.get('model_type')!r}")
    if config.get("hidden_size") != dimension:
        raise ValueError(f"{root.name}: hidden_size {config.get('hidden_size')} differs from "
                         f"PAIR.json dimension {dimension}")
    if not 2 <= record["max_tokens"] <= int(config["max_position_embeddings"]):
        raise ValueError(f"{root.name}: max_tokens {record['max_tokens']} exceeds "
                         f"max_position_embeddings {config['max_position_embeddings']}")
    pooling = json_file(root / "1_Pooling" / "config.json")
    if (pooling.get("pooling_mode_mean_tokens") is not True
            or any(pooling.get(mode) for mode in POOLING_MODES)
            or pooling.get("include_prompt", True) is not True
            or pooling.get("word_embedding_dimension", dimension) != dimension):
        raise ValueError(f"{root.name}: pair towers require mean pooling including the prompt")
    modules = [module.get("type", "") for module in json_file(root / "modules.json")]
    if (not modules or not modules[-1].endswith(".Normalize")
            or any(module.endswith(".Dense") for module in modules)
            or (root / "2_Dense").exists()):
        raise ValueError(f"{root.name}: pair towers require a final Normalize (L2) and no Dense head")
    sentence = root / "sentence_bert_config.json"
    if sentence.is_file():
        values = json_file(sentence)
        if values.get("max_seq_length", record["max_tokens"]) != record["max_tokens"]:
            raise ValueError(f"{root.name}: sentence_bert_config max_seq_length differs from "
                             "PAIR.json max_tokens")
        if values.get("do_lower_case"):
            raise ValueError(f"{root.name}: sentence_bert_config lower-cases input")
    declared = root / "config_sentence_transformers.json"
    prompts = json_file(declared).get("prompts", {}) if declared.is_file() else {}
    if prompt in prompts and prompts[prompt] != record["prefix"]:
        raise ValueError(f"{root.name}: PAIR.json prefix {record['prefix']!r} differs from the "
                         f"declared {prompt!r} prompt {prompts[prompt]!r}")
    return config


def pair_tensors(tower: Tower, pieces: int, max_tokens: int) -> dict:
    """Check the loaded checkpoint against its config and tokenizer."""
    shapes = {tensor.name.split("/", 1)[1]: tensor.shape for tensor in tower.tensors}
    hidden = int(tower.config["hidden_size"])
    rows, width = shapes.get("embeddings.word_embeddings.weight", (0, 0))
    positions = shapes.get("embeddings.position_embeddings.weight", (0, 0))[0]
    layers = {int(name.split(".")[2]) for name in shapes if name.startswith("encoder.layer.")}
    if width != hidden or pieces > rows:
        raise ValueError(f"{tower.model_id}: {pieces} tokenizer pieces need at most {rows} "
                         f"embedding rows of width {hidden}")
    if positions != int(tower.config["max_position_embeddings"]) or max_tokens > positions:
        raise ValueError(f"{tower.model_id}: position embeddings do not cover max_tokens")
    if layers != set(range(int(tower.config["num_hidden_layers"]))):
        raise ValueError(f"{tower.model_id}: checkpoint layers differ from num_hidden_layers")
    return {"layers": len(layers), "pieces": pieces, "rows": rows}


def load_pair(args: argparse.Namespace) -> tuple[tuple[Tower, ...], bytes, dict[int, int]]:
    """Read both towers, prefixes and limits from one offline PAIR.json."""
    for flag, value in [("--document", args.document), ("--document-id", args.document_id),
                        ("--query", args.query), ("--query-id", args.query_id),
                        ("--query-prefix", args.query_prefix),
                        ("--alignment-digest", args.alignment_digest)]:
        if value is not None and value != "":
            raise ValueError(f"{flag} conflicts with --pair; PAIR.json supplies it")
    manifest = Path(args.pair).resolve()
    raw = manifest.read_bytes()
    pair = json.loads(raw)
    dimension = pair.get("dimension")
    if type(dimension) is not int or dimension <= 0:
        raise ValueError("PAIR.json dimension must be a positive integer")
    if pair.get("normalization") != "L2":
        raise ValueError("PAIR.json normalization must be L2")
    if pair.get("similarity") != "dot_product":
        raise ValueError("PAIR.json similarity must be dot_product")
    names = tuple(str((pair.get(role) or {}).get("name")) for role in ("query", "document"))
    contract = RELEASE_PAIRS.get(names)
    if contract is None and any(name in key for key in RELEASE_PAIRS for name in names):
        raise ValueError(f"release pair contract: {names} must name both towers of one pair")
    if contract is not None and contract["dimension"] != dimension:
        raise ValueError(f"release pair contract: dimension {dimension} != {contract['dimension']}")
    towers, limits = [], {}
    for role, number, prompt in PAIR_ROLES:
        record = pair.get(role)
        if (not isinstance(record, dict) or not isinstance(record.get("name"), str)
                or not record["name"] or not isinstance(record.get("path"), str)
                or not isinstance(record.get("prefix"), str)
                or type(record.get("max_tokens")) is not int):
            raise ValueError(f"PAIR.json {role} needs name, path, prefix and integer max_tokens")
        if record.get("pooling") != "mean then L2":
            raise ValueError(f"PAIR.json {role} pooling must be 'mean then L2'")
        root = (manifest.parent / record["path"]).resolve()
        if manifest.parent not in root.parents or not root.is_dir():
            raise ValueError(f"PAIR.json {role} path must name a folder inside the pack")
        flag = f"--{role}-max-tokens"
        override = getattr(args, f"{role}_max_tokens")
        if override is not None and override != record["max_tokens"]:
            raise ValueError(f"{flag} {override} conflicts with PAIR.json max_tokens "
                             f"{record['max_tokens']}")
        if contract is not None:
            expected = contract[role]
            observed = {key: record.get(key) for key in ["prefix", "max_tokens", "weights_sha256"]}
            if role == "document":
                observed["revision"] = record.get("revision")
            for key, value in observed.items():
                if value != expected[key]:
                    raise ValueError(f"release pair contract: {role} {key} {value!r} != {expected[key]!r}")
            if file_sha256(root / "tokenizer.json") != expected["tokenizer_sha256"]:
                raise ValueError(f"release pair contract: {role} tokenizer.json sha256 differs")
        pair_source(root, record, dimension, prompt)
        pieces = len(json_file(root / "tokenizer.json")["model"]["vocab"])
        precision = (args.document_precision if number == 0
                     else args.query_mlx_precision or args.document_precision)
        tower = load_tower(root, record["name"], number, role, record["prefix"], precision,
                           check_prompt=False)
        shape = pair_tensors(tower, pieces, record["max_tokens"])
        if contract is not None:
            for key, value in shape.items():
                if value != contract[role][key]:
                    raise ValueError(f"release pair contract: {role} {key} {value} != {contract[role][key]}")
        towers.append(tower)
        limits[number] = record["max_tokens"]
    # The alignment identity is SHA-256 of the exact manifest bytes, as release uses.
    return tuple(towers), hashlib.sha256(raw).digest(), limits


def bake(args: argparse.Namespace) -> None:
    if getattr(args, "pair", None):
        towers, alignment, limits = load_pair(args)
        return write_bundle(args, towers, alignment, limits)
    for flag, value in [("--document", args.document), ("--document-id", args.document_id),
                        ("--query-prefix", args.query_prefix)]:
        if value is None:
            raise ValueError(f"{flag} is required without --pair")
    if args.query_max_tokens is not None and not args.query:
        raise ValueError("--query-max-tokens requires --query")
    document_root = Path(args.document).resolve()
    if args.query:
        document = load_tower(document_root, args.document_id, 0, "document", "",
                              args.document_precision)
        query = load_tower(Path(args.query).resolve(), args.query_id, 1, "query", args.query_prefix,
                           args.query_mlx_precision or args.document_precision)
        towers = (document, query)
        alignment = bytes.fromhex(args.alignment_digest)
    else:
        document = load_tower(
            document_root,
            args.document_id,
            0,
            "document",
            args.query_prefix,
            args.document_precision,
        )
        towers = (document,)
        alignment = b""
    if len(towers) == 2 and not alignment:
        raise ValueError("a two-tower bundle requires --alignment-digest")
    write_bundle(args, towers, alignment, {1: args.query_max_tokens, 0: args.document_max_tokens})


def write_bundle(args: argparse.Namespace, towers: tuple[Tower, ...], alignment: bytes,
                 limits: dict[int, int | None]) -> None:
    tensors = tuple(tensor for tower in towers for tensor in tower.tensors)

    prefix = bytearray(MAGIC + u32(VERSION) + u32(0) + bytes([len(towers)]) + b"\x00" * 7)
    for tower in towers:
        prefix += encode_tower(tower, limits[tower.role])
    for tower in towers:
        prefix += encode_tokenizer(tower.root, tower.architecture)
    prefix += struct.pack("<d", args.alpha)
    prefix += u32(len(tensors))
    placeholder_descriptors = b"".join(tensor_descriptor(tensor, 0) for tensor in tensors)
    raw_header = len(prefix) + len(placeholder_descriptors) + len(field(alignment))
    header_len = int(math.ceil(raw_header / 4096.0) * 4096)
    prefix[12:16] = u32(header_len)

    unique: dict[tuple[int, int], tuple[int, bytes]] = {}
    data = bytearray()
    descriptors = bytearray()
    for tensor in tensors:
        key = (tensor.digest, len(tensor.data))
        stored = unique.get(key)
        if stored is not None and stored[1] == tensor.data:
            offset = stored[0]
        else:
            offset = header_len + len(data)
            unique[key] = (offset, tensor.data)
            data += tensor.data
        descriptors += tensor_descriptor(tensor, offset)
    body = prefix + descriptors + field(alignment)
    body += b"\x00" * (header_len - len(body))
    body += data
    body += xxhash.xxh3_128_intdigest(body).to_bytes(16, "little")
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(body)
    print(
        json.dumps(
            {
                "output": str(output),
                "bytes": len(body),
                "bundle_digest": xxhash.xxh3_128_hexdigest(body[:-16]),
                "tower_weights": {
                    tower.model_id: tower.weights_digest.hex() for tower in towers
                },
                "unique_tensors": len(unique),
                "tensor_descriptors": len(tensors),
            },
            sort_keys=True,
        )
    )


# The model card lists every task that loses more than this nDCG@10 against the ceiling.
CARD_LOSS = 0.05
CEILING = "ceiling_retrieval_e5_as_query_tower"


def card_inputs(pack: Path, pair: dict) -> dict:
    """Read and check every model card source before anything is baked."""
    for key, kind in [("target_languages", list), ("measured_retrieval", dict),
                      (CEILING, dict), ("release_status", str)]:
        if not isinstance(pair.get(key), kind) or not pair[key]:
            raise ValueError(f"release card: PAIR.json needs a non-empty {key}")
    for role in ("query", "document"):
        if type(pair[role].get("parameters")) is not int:
            raise ValueError(f"release card: PAIR.json {role} needs integer parameters")
    for group, values in pair["measured_retrieval"].items():
        if not isinstance(pair[CEILING].get(group), dict) or not isinstance(values, dict):
            raise ValueError(f"release card: {CEILING} has no {group!r} group")
    provenance = pack / "PROVENANCE.md"
    if not provenance.is_file():
        raise ValueError("release card: the pack has no PROVENANCE.md")
    licences = sorted(p for p in (pack / "licenses").rglob("*") if p.is_file())
    if not licences:
        raise ValueError("release card: the pack has no files in licenses/")
    query = pair["query"]["name"]
    if "/" in query:
        raise ValueError(f"release card: query name {query!r} is not a file stem")
    tables = []
    for name in [f"retrieval-{query}.json", "retrieval-e5-ceiling.json"]:
        path = pack / "benchmarks" / name
        if not path.is_file():
            raise ValueError(f"release card: the pack has no benchmarks/{name}")
        tables.append({(m["task"], m["hf_subset"], m["split"]): m["ndcg_at_10"]
                       for m in json_file(path)["metrics"]})
    if tables[0].keys() != tables[1].keys() or not tables[0]:
        raise ValueError("release card: the two benchmark files list different tasks")
    tasks = sorted(((key, tables[0][key], tables[1][key]) for key in tables[0]),
                   key=lambda row: (row[1] - row[2], row[0]))
    return {"provenance": provenance.read_text(), "licences": licences, "tasks": tasks}


def model_card(args: argparse.Namespace, pair: dict, pair_sha256: str, inputs: dict,
               manifest: dict, manifest_sha256: str, licences: list[str]) -> str:
    """Render the Hugging Face model card from the pack and the measured output bytes."""
    query_precision = (args.query_mlx_precision or args.document_precision).upper()
    precision = {"query": query_precision, "document": args.document_precision.upper()}
    total = sum(entry["size"] for entry in manifest["files"])
    lines = ["---", f"license: {args.card_license}", "language:"]
    lines += [f"- {language}" for language in pair["target_languages"]]
    lines += ["tags:", "- volantis-db", "- text-embeddings", "- mlx"]
    if pair["document"].get("revision"):
        lines += ["base_model:", f"- {pair['document']['name']}"]
    lines += ["---", "", f"# {args.name}", "",
              f"Two-tower text embedding model for Volantis DB. The query tower is "
              f"`{pair['query']['name']}`. The document tower is `{pair['document']['name']}`. "
              f"Each tower gives an L2-normalized vector of {pair['dimension']} dimensions. "
              f"The score is the dot product of the two vectors.", "",
              "## Towers", "",
              "| Role | Model | Revision | Parameters | Prefix | Max tokens | Pooling | Dimensions | Weights |",
              "|---|---|---|---|---|---|---|---|---|"]
    for role in ("query", "document"):
        tower = pair[role]
        lines.append(f"| {role} | `{tower['name']}` | {tower.get('revision') or '-'} | "
                     f"{tower['parameters']:,} | `{tower['prefix']}` | {tower['max_tokens']} | "
                     f"{tower['pooling']} | {pair['dimension']} | {precision[role]} |")
    lines.append("")
    for role in ("query", "document"):
        if pair[role].get("parameters_note"):
            lines.append(f"- {role.capitalize()} parameters: {pair[role]['parameters_note']}.")
        if pair[role].get("weights_sha256"):
            lines.append(f"- {role.capitalize()} source weights SHA-256 (FP32 safetensors): "
                         f"`{pair[role]['weights_sha256']}`.")
    lines += ["- The token limits include the prefix and the two special tokens.",
              "- A query longer than its limit is cut. A long document is split into chunks.", "",
              "## Runtime", ""]
    if manifest["query_coreml"] is None:
        lines.append("MLX only, on Apple silicon. No Core ML query model ships: "
                     "`query_coreml` is null in `volantis-model.json`.")
    else:
        lines.append(f"Core ML query model `{manifest['query_coreml']}` "
                     f"({args.query_coreml.upper()}, {pair['query']['max_tokens']} tokens). "
                     "The bundle also keeps the MLX query weights.")
    lines += ["", "## Files", "", "| File | Bytes | SHA-256 |", "|---|---|---|"]
    lines += [f"| `{e['path']}` | {e['size']:,} | `{e['sha256']}` |" for e in manifest["files"]]
    lines += ["", f"Download size: {total:,} bytes.",
              f"SHA-256 of `volantis-model.json`: `{manifest_sha256}`.",
              "Volantis DB opens this model by repository, a full 40-character commit of this "
              "repository and this manifest SHA-256. It checks the size and SHA-256 of each file.",
              "", "## Languages", "",
              f"Target languages: {', '.join(pair['target_languages'])}.", "",
              "Quality drops outside the target languages. These tasks lose more than "
              f"{CARD_LOSS} nDCG@10 against e5 as the query tower:", ""]
    losses = [row for row in inputs["tasks"] if row[1] - row[2] < -CARD_LOSS]
    lines += [f"- {task} {subset}: {ours:.3f} with this query tower, {ceiling:.3f} with e5."
              for (task, subset, _), ours, ceiling in losses] or ["- None."]
    lines += ["", "## Retrieval", "",
              "nDCG@10 and recall@100 of this pair, and of the same pair with e5 as the query "
              "tower (ceiling). Source: `PAIR.json` of the source pack.", "",
              "| Group | Tasks | nDCG@10 | Ceiling nDCG@10 | Recall@100 | Ceiling recall@100 |",
              "|---|---|---|---|---|---|"]
    for group, values in pair["measured_retrieval"].items():
        ceiling = pair[CEILING][group]
        lines.append(f"| {group} | {values.get('count', '-')} | {values['ndcg_at_10']:.3f} | "
                     f"{ceiling['ndcg_at_10']:.3f} | {values['recall_at_100']:.3f} | "
                     f"{ceiling['recall_at_100']:.3f} |")
    lines += ["", "Each task, largest loss first:", "",
              "| Task | Subset | Split | nDCG@10 | Ceiling | Delta |", "|---|---|---|---|---|---|"]
    lines += [f"| {task} | {subset} | {split} | {ours:.3f} | {ceiling:.3f} | {ours - ceiling:+.3f} |"
              for (task, subset, split), ours, ceiling in inputs["tasks"]]
    provenance = inputs["provenance"].strip().splitlines()
    if provenance and provenance[0].startswith("# "):
        provenance = "\n".join(provenance[1:]).strip().splitlines()
    lines += ["", "## Provenance", "", "Text of the source pack `PROVENANCE.md`:", "",
              *[f"> {line.rstrip()}".rstrip() for line in provenance], "",
              "This repository ships the text above, the model card and `licenses/`. Other "
              "source pack files, for example `provenance/` manifests and `benchmarks/`, are "
              "not in this repository.", "",
              f"Source pack status (`PAIR.json`): {pair['release_status']}", "",
              f"Source pack `PAIR.json` SHA-256: `{pair_sha256}`. "
              "The bundle stores this digest as its pair alignment identity.", "",
              "## Licences", "",
              f"Licence of this repository: `{args.card_license}`. The files below state the "
              "licence of each source and the training-data obligations. Read them before you "
              "redistribute the model.", ""]
    lines += [f"- `{path}`" for path in licences]
    return "\n".join(lines) + "\n"


def release(args: argparse.Namespace) -> None:
    if args.query_coreml_precision is not None:
        raise ValueError("--query-coreml-precision was replaced by --query-coreml none|fp16|int8")
    if args.query_coreml is None:
        raise ValueError("release requires --query-coreml none|fp16|int8")
    # Match the downloader's conservative single-component path contract.
    if (not args.name or args.name in (".", "..")
            or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_." for c in args.name)):
        raise ValueError("--name must be a safe single file stem")
    if not args.card_license or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-." for c in args.card_license):
        raise ValueError("--card-license must be a Hugging Face licence identifier")
    pack = Path(args.pack).resolve()
    pair_bytes = (pack / "PAIR.json").read_bytes()
    pair = json.loads(pair_bytes)
    inputs = card_inputs(pack, pair)
    out = Path(args.out).resolve()
    if out.exists() and (not out.is_dir() or any(out.iterdir())):
        raise FileExistsError(f"release output must be absent or empty: {out}")
    out.parent.mkdir(parents=True, exist_ok=True)
    # Stage outside the upload directory; never publish an incomplete manifest.
    with tempfile.TemporaryDirectory(prefix="ze-model-release-", dir=out.parent) as temporary:
        stage = Path(temporary)
        # PAIR.json is the only source of tower names, prefixes and limits.
        bake(argparse.Namespace(
            pair=str(pack / "PAIR.json"), document=None, document_id=None, query=None,
            query_id=None, query_prefix=None, alignment_digest="", query_max_tokens=None,
            document_max_tokens=None, document_precision=args.document_precision,
            query_mlx_precision=args.query_mlx_precision, alpha=0.5,
            output=str(stage / f"{args.name}.zem")))
        payload = [stage / f"{args.name}.zem"]
        shipped = [stage / f"{args.name}.zem"]
        if args.query_coreml != "none":
            coreml_export(argparse.Namespace(query=str(pack / pair["query"]["path"]),
                                           tokens=pair["query"]["max_tokens"],
                                           precision=args.query_coreml,
                                           output=str(stage / f"{args.name}.mlpackage")))
            # The exporter also writes source package/receipt; only compiled bytes ship.
            compiled = stage / f"{args.name}.mlmodelc"
            compiled_files = sorted(p for p in compiled.rglob("*") if p.is_file())
            if not compiled_files:
                raise ValueError("CoreML compiler produced no files")
            payload.extend(compiled_files)
            shipped.append(compiled)
        files = []
        for path in sorted(payload):
            files.append({"path": path.relative_to(stage).as_posix(),
                          "size": path.stat().st_size, "sha256": file_sha256(path)})
        manifest = {"format": 1, "name": args.name, "bundle": f"{args.name}.zem",
                    "query_coreml": None if args.query_coreml == "none" else f"{args.name}.mlmodelc",
                    "files": files}
        (stage / "volantis-model.json").write_text(json.dumps(manifest, indent=2) + "\n")
        # Licences and the card ship for people; the loader needs only the manifest files.
        licences = []
        for source in inputs["licences"]:
            target = stage / "licenses" / source.relative_to(pack / "licenses")
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(source.read_bytes())
            licences.append(target.relative_to(stage).as_posix())
        (stage / "README.md").write_text(model_card(
            args, pair, hashlib.sha256(pair_bytes).hexdigest(), inputs, manifest,
            file_sha256(stage / "volantis-model.json"), licences))
        payload += [stage / "volantis-model.json", stage / "README.md"]
        payload += [stage / path for path in licences]
        checksums = [f"{file_sha256(path)}  {path.relative_to(stage).as_posix()}\n"
                     for path in sorted(payload)]
        (stage / "SHA256SUMS").write_text("".join(checksums))
        shipped += [stage / name for name in
                    ["volantis-model.json", "README.md", "licenses", "SHA256SUMS"]]
        out.mkdir(exist_ok=True)
        for path in shipped:
            shutil.move(str(path), out / path.name)
        bundle = (out / manifest["bundle"]).stat().st_size
        print(json.dumps({"bundle_bytes": bundle,
                          "query_coreml_bytes": sum(e["size"] for e in files) - bundle,
                          "manifest_sha256": file_sha256(out / "volantis-model.json")},
                         sort_keys=True))


def _linear(torch_module, tensors: dict[str, torch.Tensor], base: str):
    weight = tensors[f"{base}.weight"]
    bias = tensors.get(f"{base}.bias")
    layer = torch_module.nn.Linear(
        int(weight.shape[1]), int(weight.shape[0]), bias=bias is not None
    )
    layer.weight = torch_module.nn.Parameter(weight, requires_grad=False)
    if bias is not None:
        layer.bias = torch_module.nn.Parameter(bias, requires_grad=False)
    return layer


def _layer_norm(torch_module, tensors: dict[str, torch.Tensor], base: str, eps: float):
    weight = tensors[f"{base}.weight"]
    layer = torch_module.nn.LayerNorm(int(weight.shape[0]), eps=eps)
    layer.weight = torch_module.nn.Parameter(weight, requires_grad=False)
    layer.bias = torch_module.nn.Parameter(
        tensors[f"{base}.bias"], requires_grad=False
    )
    return layer


def _coreml_query_module(root: Path, sequence: int):
    config = json_file(root / "config.json")
    maximum = int(config["max_position_embeddings"])
    sentence_config = root / "sentence_bert_config.json"
    if sentence_config.is_file():
        maximum = min(maximum, int(json_file(sentence_config)["max_seq_length"]))
    if not 0 < sequence <= maximum:
        raise ValueError(f"CoreML sequence must be in 1..{maximum}, got {sequence}")
    if config.get("model_type") == "arctic_query":
        from safetensors.torch import load_file

        # Use the pack's architecture, with explicit attention for conversion.
        spec = importlib.util.spec_from_file_location(
            "ze_arctic_query", root / "modeling_arctic_query.py"
        )
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
        config["attention_backend"] = "eager"
        model = module.ArcticQueryModel(module.ArcticQueryConfig(**config))
        model.load_state_dict(load_file(str(root / "model.safetensors")), strict=True)
        model.eval().float().requires_grad_(False)

        class ArcticQueryTower(torch.nn.Module):
            def __init__(self):
                super().__init__()
                self.model = model

            def forward(self, input_ids, attention_mask):
                return self.model.encode_tokens(input_ids, attention_mask)

        return ArcticQueryTower().eval()
    if config.get("model_type") != "bert":
        raise ValueError("CoreML query export requires BERT or ArcticQuery")
    tensors: dict[str, torch.Tensor] = {}
    with safe_open(root / "model.safetensors", framework="pt", device="cpu") as source:
        for name in source.keys():
            tensors[name] = source.get_tensor(name).detach().to(dtype=torch.float32)
    dense_path = root / "2_Dense" / "model.safetensors"
    if not dense_path.is_file():
        raise ValueError("CoreML query export requires the declared Dense head")
    with safe_open(dense_path, framework="pt", device="cpu") as source:
        tensors["dense.weight"] = source.get_tensor("linear.weight").to(
            dtype=torch.float32
        )
        tensors["dense.bias"] = source.get_tensor("linear.bias").to(dtype=torch.float32)

    heads = int(config["num_attention_heads"])
    hidden = int(config["hidden_size"])
    epsilon = float(config["layer_norm_eps"])

    class Block(torch.nn.Module):
        def __init__(self, layer: int) -> None:
            super().__init__()
            base = f"encoder.layer.{layer}"
            self.query = _linear(torch, tensors, f"{base}.attention.self.query")
            self.key = _linear(torch, tensors, f"{base}.attention.self.key")
            self.value = _linear(torch, tensors, f"{base}.attention.self.value")
            self.attention_output = _linear(
                torch, tensors, f"{base}.attention.output.dense"
            )
            self.attention_norm = _layer_norm(
                torch, tensors, f"{base}.attention.output.LayerNorm", epsilon
            )
            self.intermediate = _linear(
                torch, tensors, f"{base}.intermediate.dense"
            )
            self.output = _linear(torch, tensors, f"{base}.output.dense")
            self.output_norm = _layer_norm(
                torch, tensors, f"{base}.output.LayerNorm", epsilon
            )

        def forward(self, states, attention_bias):
            query = self.query(states).reshape(1, sequence, heads, hidden // heads)
            key = self.key(states).reshape(1, sequence, heads, hidden // heads)
            value = self.value(states).reshape(1, sequence, heads, hidden // heads)
            query = query.transpose(1, 2)
            key = key.transpose(1, 2)
            value = value.transpose(1, 2)
            scores = torch.matmul(query, key.transpose(-1, -2)) / math.sqrt(
                hidden // heads
            )
            attended = torch.matmul(torch.softmax(scores + attention_bias, dim=-1), value)
            attended = attended.transpose(1, 2).reshape(1, sequence, hidden)
            states = self.attention_norm(states + self.attention_output(attended))
            intermediate = torch.nn.functional.gelu(self.intermediate(states))
            return self.output_norm(states + self.output(intermediate))

    class QueryTower(torch.nn.Module):
        def __init__(self) -> None:
            super().__init__()
            self.word = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.word_embeddings.weight"], freeze=True
            )
            self.position = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.position_embeddings.weight"], freeze=True
            )
            self.token_type = torch.nn.Embedding.from_pretrained(
                tensors["embeddings.token_type_embeddings.weight"], freeze=True
            )
            self.embedding_norm = _layer_norm(
                torch, tensors, "embeddings.LayerNorm", epsilon
            )
            self.blocks = torch.nn.ModuleList(
                Block(layer) for layer in range(int(config["num_hidden_layers"]))
            )
            self.dense = _linear(torch, tensors, "dense")
            self.register_buffer(
                "positions", torch.arange(sequence, dtype=torch.int32).reshape(1, sequence)
            )

        def forward(self, input_ids, attention_mask):
            token_types = torch.zeros_like(input_ids)
            states = self.embedding_norm(
                self.word(input_ids)
                + self.position(self.positions)
                + self.token_type(token_types)
            )
            attention_bias = (attention_mask[:, None, None, :].to(torch.float32) - 1.0) * 1.0e9
            for block in self.blocks:
                states = block(states, attention_bias)
            mask = attention_mask[:, :, None].to(torch.float32)
            pooled = (states * mask).sum(dim=1) / mask.sum(dim=1)
            return torch.nn.functional.normalize(self.dense(pooled), p=2, dim=1)

    return QueryTower().eval()


def coreml_export(args: argparse.Namespace) -> None:
    try:
        import coremltools as ct
        import numpy as np
    except ImportError as error:
        raise RuntimeError("coreml-export requires coremltools in the tool venv") from error
    root = Path(args.query).resolve()
    output = Path(args.output).resolve()
    if output.suffix != ".mlpackage":
        raise ValueError("CoreML export --output must end in .mlpackage")
    compiled = output.with_suffix(".mlmodelc")
    receipt = output.with_suffix(".json")
    for path in (output, compiled, receipt):
        if path.exists():
            raise FileExistsError(f"refusing to replace CoreML export: {path}")
    sequence = args.tokens
    module = _coreml_query_module(root, sequence)
    input_ids = torch.ones((1, sequence), dtype=torch.int32)
    attention_mask = torch.ones((1, sequence), dtype=torch.int32)
    with torch.no_grad():
        traced = torch.jit.trace(module, (input_ids, attention_mask), strict=True)
    model = ct.convert(
        traced,
        convert_to="mlprogram",
        inputs=[
            ct.TensorType(name=name, shape=(1, sequence), dtype=np.int32)
            for name in ("input_ids", "attention_mask")
        ],
        outputs=[ct.TensorType(name="embedding", dtype=np.float16)],
        compute_precision=ct.precision.FLOAT16,
        compute_units=ct.ComputeUnit.CPU_AND_NE,
        minimum_deployment_target=ct.target.macOS15,
        skip_model_load=True,
    )
    if args.precision == "int8":
        config = ct.optimize.coreml.OptimizationConfig(
            global_config=ct.optimize.coreml.OpLinearQuantizerConfig(
                mode="linear_symmetric", dtype="int8", granularity="per_channel"))
        model = ct.optimize.coreml.linear_quantize_weights(model, config=config)
    metadata = {"output": str(output), "compiled": str(compiled),
                "query": str(root), "tokens": sequence,
                "precision": "INT8" if args.precision == "int8" else "FLOAT16",
                "compute_units": "CPU_AND_NE",
                "torch": torch.__version__, "coremltools": ct.__version__}
    # Absolute build paths vary per run and must not enter the compiled model.
    model.user_defined_metadata.update({key: str(value) for key, value in metadata.items()
                                        if key not in ("output", "compiled", "query")})
    output.parent.mkdir(parents=True, exist_ok=True)
    model.save(str(output))
    subprocess.run(["xcrun", "coremlcompiler", "compile", str(output),
                    str(output.parent)], check=True)
    if not compiled.is_dir():
        raise RuntimeError(f"CoreML compiler did not produce {compiled}")
    receipt.write_text(json.dumps(metadata, indent=2) + "\n")
    print(json.dumps(metadata, sort_keys=True))


def coreml_run(args: argparse.Namespace) -> None:
    try:
        import coremltools as ct
        import numpy as np
    except ImportError as error:
        raise RuntimeError("coreml-run requires coremltools in the tool venv") from error
    compute_units = {
        "cpu": ct.ComputeUnit.CPU_ONLY,
        "cpu-and-gpu": ct.ComputeUnit.CPU_AND_GPU,
        "cpu-and-neural-engine": ct.ComputeUnit.CPU_AND_NE,
    }[args.compute_units]
    raw = Path(args.input).read_bytes()
    if len(raw) < 8:
        raise ValueError("CoreML input header is truncated")
    rows, tokens = struct.unpack_from("<II", raw)
    values = rows * tokens
    ids_end = 8 + values * 4
    mask_end = ids_end + values * 4
    if mask_end != len(raw):
        raise ValueError("CoreML input payload length does not match its shape")
    ids = np.frombuffer(raw[8:ids_end], dtype="<i4").reshape(rows, tokens)
    mask = np.frombuffer(raw[ids_end:mask_end], dtype="<f4").reshape(rows, tokens)
    clock = __import__("time")
    load_started = clock.perf_counter_ns()
    model = ct.models.MLModel(str(Path(args.model)), compute_units=compute_units)
    load_ms = (clock.perf_counter_ns() - load_started) / 1.0e6
    output = []
    latencies = []
    for row in range(rows):
        prediction = None
        row_latencies = []
        for iteration in range(args.warm + args.repeat):
            started = clock.perf_counter_ns()
            prediction = model.predict(
                {
                    "input_ids": ids[row : row + 1].astype(np.int32),
                    "attention_mask": mask[row : row + 1].astype(np.int32),
                }
            )["embedding"]
            if iteration >= args.warm:
                row_latencies.append(
                    (clock.perf_counter_ns() - started) / 1.0e6
                )
        if prediction is None:
            raise ValueError("CoreML repeat count must be non-zero")
        latencies.append(row_latencies)
        output.append(np.asarray(prediction, dtype="<f4").reshape(-1))
    Path(args.output).write_bytes(np.concatenate(output).tobytes())
    print(
        json.dumps(
            {
                "compute_units": args.compute_units,
                "model_load_ms": load_ms,
                "latency_ms": latencies,
            }
        )
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="ze-model")
    commands = root.add_subparsers(dest="command", required=True)
    fetch = commands.add_parser("fetch")
    fetch.add_argument("model")
    bake_parser = commands.add_parser(
        "bake", description="Bake an immutable model bundle.",
        epilog="Pair manifest: ze-model bake --pair $PACK/PAIR.json --output pair.zem. "
               "Explicit towers: ze-model bake --document $PACK/document --document-id arctic-m-v2 "
               "--query $PACK/query --query-id clean71-v1 --query-prefix 'query: ' "
               "--alignment-digest $ALIGNMENT_DIGEST --query-max-tokens 96 "
               "--document-max-tokens 8192 --output release.zem",
    )
    bake_parser.add_argument("--pair", help="offline PAIR.json: towers, names, prefixes and limits")
    bake_parser.add_argument("--document")
    bake_parser.add_argument("--document-id")
    bake_parser.add_argument("--document-precision", choices=("fp32", "fp16"), default="fp32")
    bake_parser.add_argument("--query-mlx-precision", choices=("fp32", "fp16"),
                             help="MLX query weights (default: document precision)")
    bake_parser.add_argument("--query")
    bake_parser.add_argument("--query-id")
    bake_parser.add_argument("--query-max-tokens", type=int)
    bake_parser.add_argument("--document-max-tokens", type=int)
    bake_parser.add_argument("--query-prefix")
    bake_parser.add_argument("--alignment-digest", default="")
    bake_parser.add_argument("--alpha", type=float, default=0.5)
    bake_parser.add_argument("--output", required=True)
    release_parser = commands.add_parser("release", description="Build an upload-ready release from an offline model pack.")
    release_parser.add_argument("--pack", required=True)
    release_parser.add_argument("--out", required=True)
    release_parser.add_argument("--name", required=True)
    release_parser.add_argument("--document-precision", choices=("fp32", "fp16"), required=True)
    release_parser.add_argument("--query-mlx-precision", choices=("fp32", "fp16"),
                                help="MLX query weights (default: document precision)")
    release_parser.add_argument("--query-coreml", choices=("none", "fp16", "int8"),
                                help="Core ML query model precision; none ships MLX only (required)")
    # Removed flag: kept only so release can name its replacement.
    release_parser.add_argument("--query-coreml-precision", help=argparse.SUPPRESS)
    release_parser.add_argument("--card-license", required=True,
                                help="Hugging Face licence identifier for the model card")
    export = commands.add_parser("coreml-export")
    export.add_argument("--query", required=True)
    export.add_argument("--precision", choices=("fp16", "int8"), default="fp16")
    export.add_argument("--tokens", type=int, default=96,
                        help="fixed sequence length, bounded by the pack limit (default: 96)")
    export.add_argument("--output", required=True)
    run = commands.add_parser("coreml-run")
    run.add_argument("--model", required=True)
    run.add_argument("--input", required=True)
    run.add_argument(
        "--compute-units",
        choices=("cpu", "cpu-and-gpu", "cpu-and-neural-engine"),
        required=True,
    )
    run.add_argument("--output", required=True)
    run.add_argument("--warm", type=int, default=0)
    run.add_argument("--repeat", type=int, default=1)
    return root


def main() -> None:
    args = parser().parse_args()
    if args.command == "fetch":
        print(snapshot_download(args.model))
        return
    if args.command == "coreml-export":
        coreml_export(args)
        return
    if args.command == "coreml-run":
        coreml_run(args)
        return
    if args.command == "release":
        release(args)
        return
    if args.query and not args.query_id:
        raise ValueError("--query-id is required with --query")
    bake(args)


if __name__ == "__main__":
    main()
